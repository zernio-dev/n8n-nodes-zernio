{
  "_comment": "SATU sumber kebenaran daftar provider free-ai-probe. Dibaca oleh freeai.py, freeai_client.mjs, probe_free_ai.py, dan freeai_gateway.py (lewat freeai). Untuk menambah provider: tambahkan objek di 'providers', lalu id-nya di 'failover' (kalau ikut rantai gateway) dan/atau 'probe_order' (kalau mau ikut diprobe).",
  "_fields": {
    "id": "kunci provider, dipakai oleh chat(provider_id, ...) dan --provider",
    "name": "label utama (freeai.py, klien Node, /v1/models, gateway)",
    "probe_name": "opsional; label khusus probe_free_ai.py kalau berbeda dari name",
    "base": "base URL OpenAI-compatible (endpoint chat = base + /chat/completions)",
    "model": "model default provider",
    "key_env": "nama env var berisi API key, atau null kalau anonim",
    "optional_key": "opsional; true = probe pakai key kalau ada, jalan tanpa key kalau tidak (hanya dipakai probe)",
    "core": "opsional; false = hanya ada di probe, tidak masuk registry freeai/klien/gateway"
  },

  "failover": [
    "ovh",
    "llm7",
    "openrouter",
    "tip",
    "arzastore",
    "cleanapis",
    "netraux",
    "jeroker"
  ],

  "bench_interval": {
    "ovh": 31,
    "llm7": 26,
    "kilo": 12,
    "openrouter": 4,
    "tip": 6,
    "arzastore": 6,
    "cleanapis": 6,
    "netraux": 6,
    "jeroker": 6
  },

  "probe_order": [
    "llm7",
    "ovh",
    "kilo",
    "aion",
    "groq",
    "gemini",
    "openrouter",
    "mistral",
    "siliconflow",
    "netraux",
    "jeroker"
  ],

  "providers": [
    {
      "id": "ovh",
      "name": "OVHcloud AI Endpoints",
      "probe_name": "OVHcloud AI Endpoints (anonim)",
      "base": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "model": "gpt-oss-20b",
      "key_env": null
    },
    {
      "id": "llm7",
      "name": "LLM7.io",
      "probe_name": "LLM7.io (anonim)",
      "base": "https://api.llm7.io/v1",
      "model": "DeepSeek-V4-Flash-0731",
      "key_env": null
    },
    {
      "id": "openrouter",
      "name": "OpenRouter (free pool)",
      "probe_name": "OpenRouter",
      "base": "https://openrouter.ai/api/v1",
      "model": "openrouter/free",
      "key_env": "OPENROUTER_API_KEY"
    },
    {
      "id": "tip",
